# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Laptop smoke runs (meaningless numbers)
results/**/*_smoke/
results/**/*_stopped/
results/analysis/*smoke*/
logs/*
!logs/.gitkeep

# Large run artefacts (kept on disk, not in git)
results/**/models/
results/**/*.npz
results/**/*.pt

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
