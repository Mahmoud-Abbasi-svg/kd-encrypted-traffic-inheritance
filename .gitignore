# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Regenerable model artefacts too large for a git host (GitHub rejects files over 100 MB).
# `scripts/10_cpu_cost.py` rebuilds xgb.json from the cached arrays whenever it is run.
results/**/xgb.json

# Laptop smoke runs (meaningless numbers)
results/**/*_smoke/
results/**/*_stopped/
results/analysis/*smoke*/
logs/*
!logs/.gitkeep

# Large run artefacts (kept on disk, not in git)
results/**/models/
results/**/*.npz
results/**/*.pt

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Data-deposit archives (multi-GB, uploaded to Zenodo, not stored in git)
deposit/*.zip
